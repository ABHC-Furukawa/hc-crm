# Supabase PostgreSQL (Prisma)
# App runtime: Supabase connection pooler (port 6543). Newer projects use aws-1-[region].
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: pooler session mode (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Password reset redirectTo（本番は実際の URL に変更）
NEXT_PUBLIC_SITE_URL="http://localhost:3003"
# Server-only: user account creation (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only: nightly KPI cache sync (GitHub Actions / scripts/sync-activity-metrics-daily.mjs)
CRON_SECRET="generate-a-long-random-string"
# Production URL for cron script (GitHub secret APP_URL). Local dev uses NEXT_PUBLIC_SITE_URL.
APP_URL="https://your-production-domain.example"