# Supabase PostgreSQL (Prisma)
# App runtime: Supabase connection pooler (port 6543). Newer projects use aws-1-[region].
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: pooler session mode (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Password reset redirectTo（本番は実際の URL に変更）
NEXT_PUBLIC_SITE_URL="http://localhost:3003"
# Server-only: user account creation (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only: nightly KPI cache sync (GitHub Actions / scripts/sync-activity-metrics-daily.mjs)
CRON_SECRET="generate-a-long-random-string"
# Production URL for cron script (GitHub secret APP_URL). Local dev uses NEXT_PUBLIC_SITE_URL.
APP_URL="https://your-production-domain.example"

# Phase 5: Job Operations — Google Sheets sync
# Spreadsheet ID (1 file, tabs per company): URL /d/{ID}/edit
JOB_SPREADSHEET_ID="your-spreadsheet-id"
# Optional: override tab configs as JSON array (see lib/jobs/sheets/company-sheet-config.ts)
# JOB_SHEET_TABS='[{"companyKey":"company-01","displayName":"A社","sheetName":"A社","headerRow":1,"dataStartRow":2}]'
# Service account JSON (single line). Share the spreadsheet with the SA email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Optional: tenant UUID for cron sync (defaults to default tenant)
# JOB_SYNC_TENANT_ID="a0000000-0000-4000-a000-000000000001"

# Phase 6: CallLead bulk import — Google Sheets sync
# Spreadsheet ID: URL /d/{ID}/edit
CALL_LEAD_SPREADSHEET_ID="your-call-lead-spreadsheet-id"
# Tab name (default: 架電リスト)
CALL_LEAD_SHEET_NAME="架電リスト"
# Optional: 1-based row numbers. 0 = auto-detect header / data start
# CALL_LEAD_HEADER_ROW="0"
# CALL_LEAD_DATA_START_ROW="0"
# Incremental sync: first run imports newest N rows; later runs append new rows only
CALL_LEAD_SYNC_INITIAL_LIMIT="5000"
# Optional: set to "full" to import all sheet rows (disables incremental window)
# CALL_LEAD_SYNC_MODE="full"
# Optional: tenant UUID for CLI/cron sync (defaults to default tenant)
# CALL_LEAD_SYNC_TENANT_ID="a0000000-0000-4000-a000-000000000001"
# Cron (GitHub Actions): GET /api/cron/call-lead-sync with Authorization: Bearer CRON_SECRET

# Resume feature — proof photo storage (Supabase Storage bucket, create as public or use signed URLs)
# RESUME_PHOTOS_BUCKET="resume-photos"
# Optional: PDF export cache bucket (Phase 5+; on-demand generation works without this)
# RESUME_EXPORTS_BUCKET="resume-exports"

# Improvement requests — Slack incoming webhook (developer notifications)
# IMPROVEMENT_REQUEST_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."