// CA CRM — Prisma Schema
// Candidate中心 / Communication中心 / PBX・LINE・Email統合

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase connection pooling
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  DEVELOP
  ADMIN
  MANAGER
  ADVISOR
}

enum CandidateStatus {
  HEARING          // ヒアリング
  JOB_PROPOSAL     // 案件提案
  ENTRY            // エントリー
  INTERVIEW_PREP   // 面談対策
  FIRST_INTERVIEW  // 一次面接
  FACTORY_TOUR     // 工場見学
  OFFER_ACCEPTED   // 内定承諾
  JOINED           // 入社
  WITHDRAWN        // 辞退
  REJECTED         // 不採用
  UNREACHABLE      // 不通
  NOT_REFERRABLE   // 紹介不可
  LOST             // 失注
}

enum CommutingArrangement {
  HOME_COMMUTE // 自宅通い
  DORMITORY    // 入寮
}

enum CommuteMeans {
  CAR            // 自動車
  MOTORBIKE      // 二輪車
  BICYCLE        // 自転車
  BIKE           // バイク
  PUBLIC_TRANSIT // 公共交通機関
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  DISPATCH
  PART_TIME
  STUDENT
  OTHER
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  DISPATCH
  CONTRACT
  TEMPORARY
  OTHER
  UNKNOWN
}

enum VisionCorrection {
  NAKED_EYE // 裸眼
  GLASSES   // 眼鏡
  CONTACT   // コンタクト
  UNKNOWN
}

enum VisaStatus {
  JAPANESE
  PERMANENT
  WORK
  STUDENT
  DEPENDENT
  SPECIFIED_SKILLED
  OTHER
  UNKNOWN
}

enum AssignmentRole {
  PRIMARY
  SECONDARY
}

enum CompanyStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  CLOSED
}

enum CompanyIndustry {
  IT
  FINANCE
  MANUFACTURING
  RETAIL
  HEALTHCARE
  CONSULTING
  MEDIA
  EDUCATION
  OTHER
}

enum TagCategory {
  SKILL
  EXPERIENCE
  PREFERENCE
  STATUS
  CUSTOM
}

enum NoteType {
  GENERAL
  INTERVIEW
  FOLLOW_UP
  INTERNAL
}

enum CommunicationChannel {
  CALL
  EMAIL
  SMS
  LINE
  MEETING
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CommunicationStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum PbxProvider {
  TWILIO
  MIITEL
  BIZTEL
  ZOOM_PHONE
  ASTERISK
  FREEPBX
  CUSTOM
  UNKNOWN
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  ANSWERED
  COMPLETED
  MISSED
  VOICEMAIL
  BUSY
  FAILED
  CANCELLED
}

enum RecordingStatus {
  NONE
  PENDING
  AVAILABLE
  FAILED
  EXPIRED
}

enum TranscriptStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AiSummaryStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LineConversationStatus {
  OPEN
  CLOSED
  BLOCKED
}

enum LineMessageType {
  TEXT
  IMAGE
  STICKER
  FILE
  FLEX
  LOCATION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMUNICATION_LOGGED
  CALL_COMPLETED
  FILE_UPLOADED
  NOTE_ADDED
  TAG_ASSIGNED
  TAG_REMOVED
  APPLICATION_SUBMITTED
}

enum ActivityEntityType {
  CANDIDATE
  COMPANY
  COMMUNICATION
  CALL
  LINE_CONVERSATION
  LINE_MESSAGE
  EMAIL_THREAD
  EMAIL_MESSAGE
  TASK
  FILE
  NOTE
  TAG
  APPLICATION
  CANDIDATE_ASSIGNMENT
  USER
}

enum FileCategory {
  RESUME
  CV
  PORTFOLIO
  CONTRACT
  RECORDING
  TRANSCRIPT
  OTHER
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEW_1
  INTERVIEW_2
  INTERVIEW_FINAL
  OFFER
  ACCEPTED
  REJECTED_BY_COMPANY
  REJECTED_BY_CANDIDATE
  WITHDRAWN
}

// ── Phase 2.5: CallLead（架電管理）──

enum CallLeadStatus {
  BLANK
  HEARING
  NO_ANSWER
  DUPLICATE
  OUT_OF_SCOPE
  CONVERTED
}

enum ImportSourceType {
  CSV
  GOOGLE_SHEET
  API
  MANUAL
  MEDIA
  AGENCY
}

enum ImportLogStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CallDialProvider {
  TEL
  TWILIO
  AMAZON_CONNECT
  OTHER
}

enum CallAttemptStatus {
  INITIATED
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  MISSED
}

enum CallAttemptResult {
  CONNECTED
  NO_ANSWER
  BUSY
  CALL_BACK
  REJECTED
}

enum CallLeadActivityAction {
  IMPORTED
  CALL_INITIATED
  CALL_RESULT_RECORDED
  HEARING_COMPLETED
  CONVERTED_TO_CANDIDATE
  NOTE_ADDED
  FOLLOW_UP_SET
  STATUS_CHANGED
  UPDATED
}

enum CallLeadEntityType {
  CALL_LEAD
  CALL_ATTEMPT
  CALL_LEAD_NOTE
  IMPORT_LOG
  CANDIDATE
}

// ── Phase 3: KPI / 月次目標 ──

enum KpiMetricType {
  CALL_COUNT
  HEARING_COUNT
  PROPOSAL_COUNT
  ENTRY_COUNT
  INTERVIEW_PREP_COUNT
  INTERVIEW_SET_COUNT
  OFFER_COUNT
  OFFER_ACCEPTED_COUNT
  JOINED_COUNT
  ENTRY_AMOUNT
  INTERVIEW_SET_AMOUNT
  JOINED_AMOUNT
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantLimitPolicy {
  BLOCK
  EVICT_OLDEST
}

enum TenantAuditAction {
  LIMIT_BLOCKED
  RECORD_EVICTED
  EVICT_FALLBACK_BLOCK
  PLAN_CHANGED
  USER_INVITED
}

enum GoalPeriodType {
  MONTHLY
  WEEKLY
}

// ─────────────────────────────────────────────
// User — CA担当者
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  authId    String   @unique @map("auth_id") // Supabase Auth UID
  email     String   @unique
  name      String
  lastName  String   @map("last_name")
  firstName String?  @map("first_name")
  role      UserRole @default(ADVISOR)
  managerId String?  @map("manager_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  pendingInvite Boolean  @default(false) @map("pending_invite")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  manager                User?             @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                User[]            @relation("UserManager")
  createdCandidates      Candidate[]           @relation("CandidateCreator")
  candidateAssignments   CandidateAssignment[]
  managedCompanies       Company[]             @relation("AccountManager")
  communications         Communication[]
  assignedTasks          Task[]                @relation("TaskAssignee")
  activities             Activity[]
  uploadedFiles          File[]                @relation("FileUploader")
  notes                  Note[]                @relation("NoteAuthor")
  assignedTags           CandidateTag[]        @relation("TagAssigner")
  answeredCalls          Call[]                @relation("CallAnswerer")
  assignedCallLeads      CallLead[]            @relation("CallLeadAssignee")
  callAttempts           CallAttempt[]         @relation("CallAttemptCaller")
  callLeadNotes          CallLeadNote[]        @relation("CallLeadNoteAuthor")
  callLeadActivities     CallLeadActivity[]    @relation("CallLeadActivityUser")
  kpiGoals               KpiGoal[]             @relation("KpiGoalUser")
  activityMetricsDaily   ActivityMetricDaily[] @relation("ActivityMetricUser")
  tenantAuditLogs        TenantAuditLog[]      @relation("TenantAuditActor")

  @@index([tenantId])
  @@index([managerId])
  @@map("users")
}

// ─────────────────────────────────────────────
// Candidate — 候補者（中心エンティティ）
// ─────────────────────────────────────────────

model Candidate {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  createdById    String?         @map("created_by_id") @db.Uuid
  lastName       String          @map("last_name")
  firstName      String          @map("first_name")
  lastNameKana   String?         @map("last_name_kana")
  firstNameKana  String?         @map("first_name_kana")
  furigana       String?
  email          String?
  phone          String // E.164推奨 — partial UNIQUE via migration SQL
  phoneSecondary String?         @map("phone_secondary")
  birthDate      DateTime?       @map("birth_date") @db.Date
  age            Int?
  postalCode     String?         @map("postal_code")
  addressLine    String?         @map("address_line") @db.Text
  status         CandidateStatus @default(HEARING)
  source         String          @default("OTHER") // lib/constants/candidate-sources.ts

  // 就業状況
  employmentStatus     EmploymentStatus? @map("employment_status")
  availableDate        DateTime?         @map("available_date") @db.Date
  latestEmploymentType EmploymentType?   @map("latest_employment_type")
  dispatchCompany      String?           @map("dispatch_company")
  resignationReason    String?           @map("resignation_reason") @db.Text

  // 職歴
  manufacturingExperience Boolean? @map("manufacturing_experience")
  factoryExperience       Boolean? @map("factory_experience")
  workDescription         String?  @map("work_description") @db.Text
  otherCompanySelection   String?  @map("other_company_selection") @db.Text

  // 希望条件
  desiredSalaryNet   Int?                  @map("desired_salary_net") // 手取り（万円）
  desiredSalaryGross Int?                  @map("desired_salary_gross") // 月収目安（万円）
  desiredArea        String?               @map("desired_area")
  commutingArrangement CommutingArrangement? @map("commuting_arrangement")
  commuteMeans       CommuteMeans?         @map("commute_means")
  shiftWork          Boolean?              @map("shift_work")
  heavyLiftingOk     Boolean?              @map("heavy_lifting_ok")

  // 身体情報
  height       Int?          // cm
  weight       Int?          // kg
  shoeSize     Float?        @map("shoe_size") // cm
  clothingSize String?       @map("clothing_size")
  visionCorrection VisionCorrection? @map("vision_correction")
  visionRight      Float?            @map("vision_right")
  visionLeft       Float?            @map("vision_left")
  hasTattoo            Boolean? @map("has_tattoo")
  tattooDetail         String?  @map("tattoo_detail") @db.Text
  hasMedicalTreatment  Boolean? @map("has_medical_treatment")
  medicalTreatmentDetail String? @map("medical_treatment_detail") @db.Text
  hasDisability        Boolean? @map("has_disability")
  disabilityDetail     String?  @map("disability_detail") @db.Text

  // その他
  nationality   String?
  visaStatus    VisaStatus? @map("visa_status")
  qualifications String[]   @default([])
  hearingMemo   String?     @map("hearing_memo") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // ソフトデリート

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy        User?                  @relation("CandidateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments      CandidateAssignment[]
  communications   Communication[]
  lineConversations LineConversation[]
  emailThreads     EmailThread[]
  tasks            Task[]
  activities       Activity[]
  files            File[]
  applications     Application[]
  notes            Note[]
  tags             CandidateTag[]
  jobCase          CandidateJobCase?
  convertedFromCallLeads CallLead[] @relation("CallLeadConversion")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([deletedAt])
  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([phoneSecondary])
  @@index([updatedAt(sort: Desc)])
  @@map("candidates")
}

// ─────────────────────────────────────────────
// CandidateAssignment — 複数CA担当（PRIMARY / SECONDARY）
// ─────────────────────────────────────────────

model CandidateAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  candidateId  String         @map("candidate_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  role         AssignmentRole
  assignedAt   DateTime       @default(now()) @map("assigned_at")
  unassignedAt DateTime?      @map("unassigned_at") // null = 現役担当

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([candidateId, role, unassignedAt])
  @@index([userId, role, unassignedAt])
  @@map("candidate_assignments")
}

// ─────────────────────────────────────────────
// CandidateJobCase — 候補者の進行中案件（1:1）
// ─────────────────────────────────────────────

model CandidateJobCase {
  id                  String    @id @default(uuid()) @db.Uuid
  candidateId         String    @unique @map("candidate_id") @db.Uuid
  entryJobName        String?   @map("entry_job_name")
  dispatchCompanyName String?   @map("dispatch_company_name")
  referralFee         Int?      @map("referral_fee") // 万円
  interviewPrepAt     DateTime? @map("interview_prep_at")
  interviewAt         DateTime? @map("interview_at")
  factoryTourAt       DateTime? @map("factory_tour_at") @db.Date
  offerAcceptedAt     DateTime? @map("offer_accepted_at") @db.Date
  scheduledJoinAt     DateTime? @map("scheduled_join_at") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_job_cases")
}

// ─────────────────────────────────────────────
// Company — 求人企業（クライアント）
// ─────────────────────────────────────────────

model Company {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  accountManagerId String?         @map("account_manager_id") @db.Uuid
  name             String
  nameKana         String?         @map("name_kana")
  industry         CompanyIndustry @default(OTHER)
  status           CompanyStatus   @default(PROSPECT)
  phone            String?
  email            String?
  website          String?
  address          String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountManager User?         @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  applications   Application[]
  notes          Note[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([accountManagerId])
  @@index([status])
  @@index([deletedAt])
  @@index([name])
  @@map("companies")
}

// ─────────────────────────────────────────────
// Tag — タグマスタ
// ─────────────────────────────────────────────

model Tag {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  category    TagCategory @default(CUSTOM)
  color       String      @default("#6366f1") // hex for UI badge
  description String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  candidates CandidateTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([category])
  @@map("tags")
}

// ─────────────────────────────────────────────
// CandidateTag — 候補者×タグ（中間テーブル）
// ─────────────────────────────────────────────

model CandidateTag {
  candidateId  String   @map("candidate_id") @db.Uuid
  tagId        String   @map("tag_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("TagAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([candidateId, tagId])
  @@index([tagId, candidateId])
  @@index([assignedById])
  @@map("candidate_tags")
}

// ─────────────────────────────────────────────
// Note — 構造化メモ
// ─────────────────────────────────────────────

model Note {
  id            String   @id @default(uuid()) @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  type          NoteType @default(GENERAL)
  content       String   @db.Text
  isPinned      Boolean  @default(false) @map("is_pinned")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author      User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([companyId])
  @@index([applicationId])
  @@index([candidateId, isPinned])
  @@index([deletedAt])
  @@map("notes")
}

// ─────────────────────────────────────────────
// Communication — コミュニケーション（中心ハブ）
// ─────────────────────────────────────────────

model Communication {
  id          String                 @id @default(uuid()) @db.Uuid
  candidateId String                 @map("candidate_id") @db.Uuid
  userId      String?                @map("user_id") @db.Uuid
  channel     CommunicationChannel
  direction   CommunicationDirection
  subject     String?
  body        String?                @db.Text
  status      CommunicationStatus    @default(SENT)
  occurredAt  DateTime               @map("occurred_at") // 実際のやり取り日時
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  call         Call?
  lineMessage  LineMessage?
  emailMessage EmailMessage?
  files        File[]
  tasks        Task[]

  @@index([candidateId, occurredAt(sort: Desc)])
  @@index([userId])
  @@index([channel])
  @@map("communications")
}

// ─────────────────────────────────────────────
// Call — 通話（Communication 1:1 拡張 / PBX統合）
// ─────────────────────────────────────────────

model Call {
  id              String @id @default(uuid()) @db.Uuid
  communicationId String @unique @map("communication_id") @db.Uuid

  // PBX integration
  provider       PbxProvider @default(UNKNOWN) @map("provider")
  externalCallId String?     @map("external_call_id") // Webhook冪等キー（provider と複合UNIQUE）
  parentCallId   String?     @map("parent_call_id") @db.Uuid // 転送元通話
  fromNumber     String      @map("from_number")
  toNumber       String      @map("to_number")
  callStatus     CallStatus  @default(INITIATED) @map("call_status")
  durationSeconds Int?       @map("duration_seconds")
  answeredByUserId String?   @map("answered_by_user_id") @db.Uuid

  // Recording
  recordingUrl         String?         @map("recording_url")
  recordingStoragePath String?         @map("recording_storage_path")
  recordingStatus      RecordingStatus @default(NONE) @map("recording_status")

  // AI pipeline
  transcript         String?          @db.Text
  transcriptStatus   TranscriptStatus @default(NONE) @map("transcript_status")
  transcriptError    String?          @map("transcript_error") @db.Text
  aiSummary          String?          @map("ai_summary") @db.Text
  aiSummaryStatus    AiSummaryStatus  @default(NONE) @map("ai_summary_status")
  aiSummaryError     String?          @map("ai_summary_error") @db.Text
  aiSummaryModel     String?          @map("ai_summary_model")
  aiSummaryAt        DateTime?        @map("ai_summary_at")
  pipelineRetryCount Int              @default(0) @map("pipeline_retry_count")

  // Timestamps from PBX
  startedAt  DateTime? @map("started_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")

  // Provider-specific payload (SIP headers, leg IDs, etc.)
  pbxMetadata Json? @map("pbx_metadata") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  answeredBy    User?         @relation("CallAnswerer", fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, externalCallId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([callStatus])
  @@index([transcriptStatus])
  @@index([aiSummaryStatus])
  @@index([transcriptStatus, aiSummaryStatus])
  @@index([endedAt(sort: Desc)])
  @@index([parentCallId])
  @@map("calls")
}

// ─────────────────────────────────────────────
// LineConversation — LINE会話スレッド
// ─────────────────────────────────────────────

model LineConversation {
  id            String                 @id @default(uuid()) @db.Uuid
  candidateId   String                 @map("candidate_id") @db.Uuid
  lineChannelId String                 @map("line_channel_id") // 公式アカウントチャネルID
  lineUserId    String                 @map("line_user_id") // LINEユーザーID (Uxxxx)
  status        LineConversationStatus @default(OPEN)
  lastMessageAt DateTime?              @map("last_message_at")
  unreadCount   Int                    @default(0) @map("unread_count")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages  LineMessage[]

  @@unique([lineChannelId, lineUserId])
  @@index([candidateId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("line_conversations")
}

// ─────────────────────────────────────────────
// LineMessage — LINEメッセージ（Communication 1:1 拡張）
// ─────────────────────────────────────────────

model LineMessage {
  id                 String          @id @default(uuid()) @db.Uuid
  lineConversationId String          @map("line_conversation_id") @db.Uuid
  communicationId    String          @unique @map("communication_id") @db.Uuid
  externalMessageId  String?         @map("external_message_id") // LINE message ID
  messageType        LineMessageType @default(TEXT) @map("message_type")
  replyToken         String?         @map("reply_token") // 返信用（短期TTL）
  rawPayload         Json?           @map("raw_payload") @db.JsonB
  createdAt          DateTime        @default(now()) @map("created_at")

  lineConversation LineConversation @relation(fields: [lineConversationId], references: [id], onDelete: Cascade)
  communication    Communication    @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([lineConversationId, externalMessageId])
  @@index([lineConversationId, createdAt(sort: Desc)])
  @@map("line_messages")
}

// ─────────────────────────────────────────────
// EmailThread — メールスレッド
// ─────────────────────────────────────────────

model EmailThread {
  id               String    @id @default(uuid()) @db.Uuid
  candidateId      String    @map("candidate_id") @db.Uuid
  subject          String?
  externalThreadId String?   @map("external_thread_id") // Gmail/Outlook thread ID
  lastMessageAt    DateTime? @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages  EmailMessage[]

  @@index([candidateId])
  @@index([externalThreadId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("email_threads")
}

// ─────────────────────────────────────────────
// EmailMessage — メール（Communication 1:1 拡張）
// ─────────────────────────────────────────────

model EmailMessage {
  id                String   @id @default(uuid()) @db.Uuid
  emailThreadId     String   @map("email_thread_id") @db.Uuid
  communicationId   String   @unique @map("communication_id") @db.Uuid
  messageId         String?  @map("message_id") // RFC 5322 Message-ID
  externalMessageId String?  @map("external_message_id") // Gmail/Outlook API ID
  inReplyTo         String?  @map("in_reply_to")
  fromAddress       String   @map("from_address")
  toAddresses       String[] @map("to_addresses")
  ccAddresses       String[] @default([]) @map("cc_addresses")
  htmlBody          String?  @map("html_body") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  emailThread   EmailThread   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([messageId])
  @@index([emailThreadId, createdAt(sort: Desc)])
  @@index([fromAddress])
  @@map("email_messages")
}

// ─────────────────────────────────────────────
// Task — フォロータスク
// ─────────────────────────────────────────────

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  candidateId     String       @map("candidate_id") @db.Uuid
  assignedToId    String?      @map("assigned_to_id") @db.Uuid
  communicationId String?      @map("communication_id") @db.Uuid
  title           String
  description     String?      @db.Text
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueAt           DateTime?    @map("due_at")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([status, dueAt])
  @@map("tasks")
}

// ─────────────────────────────────────────────
// Activity — 監査ログ / タイムライン
// ─────────────────────────────────────────────

model Activity {
  id          String             @id @default(uuid()) @db.Uuid
  candidateId String             @map("candidate_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid // null = system/webhook
  action      ActivityAction
  entityType  ActivityEntityType @map("entity_type")
  entityId    String             @map("entity_id") @db.Uuid
  metadata    Json?              @db.JsonB
  occurredAt  DateTime           @default(now()) @map("occurred_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([candidateId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("activities")
}

// ─────────────────────────────────────────────
// File — 添付ファイル（Supabase Storage）
// ─────────────────────────────────────────────

model File {
  id              String       @id @default(uuid()) @db.Uuid
  candidateId     String       @map("candidate_id") @db.Uuid
  uploadedById    String       @map("uploaded_by_id") @db.Uuid
  communicationId String?      @map("communication_id") @db.Uuid
  applicationId   String?      @map("application_id") @db.Uuid
  fileName        String       @map("file_name")
  storagePath     String       @unique @map("storage_path") // Supabase Storage object path
  mimeType        String       @map("mime_type")
  sizeBytes       Int          @map("size_bytes")
  category        FileCategory @default(OTHER)
  createdAt       DateTime     @default(now()) @map("created_at")

  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([applicationId])
  @@map("files")
}

// ─────────────────────────────────────────────
// Application — 選考・応募管理
// ─────────────────────────────────────────────

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  candidateId String            @map("candidate_id") @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  jobTitle    String            @map("job_title")
  status      ApplicationStatus @default(DRAFT)
  appliedAt   DateTime?         @map("applied_at")
  interviewAt DateTime?         @map("interview_at")
  offerAt     DateTime?         @map("offer_at")
  closedAt    DateTime?         @map("closed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  files     File[]
  notes     Note[]

  @@unique([candidateId, companyId, jobTitle])
  @@index([candidateId])
  @@index([companyId])
  @@index([status])
  @@map("applications")
}

// ─────────────────────────────────────────────
// Tenant — SaaS テナント（Phase 2.5 基盤 / Phase 4a で CRM コアに tenantId 追加）
// ─────────────────────────────────────────────

model Tenant {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  plan      TenantPlan @default(FREE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users                User[]
  candidates           Candidate[]
  companies            Company[]
  tags                 Tag[]
  callLeads            CallLead[]
  importLogs           ImportLog[]
  callLeadActivities   CallLeadActivity[]
  kpiGoals             KpiGoal[]
  activityMetricsDaily ActivityMetricDaily[]
  auditLogs            TenantAuditLog[]

  @@map("tenants")
}

model TenantAuditLog {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  action    TenantAuditAction
  actorId   String?           @map("actor_id") @db.Uuid
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TenantAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tenant_audit_logs")
}

// ─────────────────────────────────────────────
// CallLead — 架電対象（Candidate 前段階）
// ─────────────────────────────────────────────

model CallLead {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  appliedAt            DateTime?        @map("applied_at")
  name                 String
  email                String?
  phone                String?
  age                  Int?
  applicationArea      String?          @map("application_area")
  assignedUserId       String?          @map("assigned_user_id") @db.Uuid
  status               CallLeadStatus   @default(BLANK)
  callCount            Int              @default(0) @map("call_count")
  lastCalledAt         DateTime?        @map("last_called_at")
  nextCallDate         DateTime?        @map("next_call_date") @db.Date
  nextCallMemo         String?          @map("next_call_memo") @db.Text
  sourceType           ImportSourceType @map("source_type")
  sourceName           String?          @map("source_name")
  sourceId             String?          @map("source_id")
  importedAt           DateTime?        @map("imported_at")
  convertedCandidateId String?          @map("converted_candidate_id") @db.Uuid
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedUser       User?              @relation("CallLeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  convertedCandidate Candidate?         @relation("CallLeadConversion", fields: [convertedCandidateId], references: [id], onDelete: SetNull)
  callAttempts       CallAttempt[]
  notes              CallLeadNote[]
  activities         CallLeadActivity[]

  @@index([tenantId, status])
  @@index([tenantId, nextCallDate])
  @@index([tenantId, deletedAt])
  @@index([tenantId, appliedAt(sort: Desc)])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, assignedUserId])
  @@index([convertedCandidateId])
  @@map("call_leads")
}

// ─────────────────────────────────────────────
// CallAttempt — 架電試行（PBX 拡張フィールド含む）
// ─────────────────────────────────────────────

model CallAttempt {
  id             String             @id @default(uuid()) @db.Uuid
  callLeadId     String             @map("call_lead_id") @db.Uuid
  calledById     String             @map("called_by_id") @db.Uuid
  calledAt       DateTime           @default(now()) @map("called_at")
  provider       CallDialProvider   @default(TEL)
  externalCallId String?            @map("external_call_id")
  startedAt      DateTime?          @map("started_at")
  endedAt        DateTime?          @map("ended_at")
  duration       Int?
  result         CallAttemptResult?
  callStatus     CallAttemptStatus  @default(INITIATED) @map("call_status")
  memo           String?            @db.Text
  recordingUrl   String?            @map("recording_url")
  transcript     String?            @db.Text
  summary        String?            @db.Text
  nextAction     String?            @map("next_action") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  callLead CallLead @relation(fields: [callLeadId], references: [id], onDelete: Cascade)
  calledBy User     @relation("CallAttemptCaller", fields: [calledById], references: [id], onDelete: Restrict)

  @@index([callLeadId, calledAt(sort: Desc)])
  @@index([calledById, calledAt(sort: Desc)])
  @@index([provider, externalCallId])
  @@map("call_attempts")
}

// ─────────────────────────────────────────────
// CallLeadNote — 架電リード用メモ
// ─────────────────────────────────────────────

model CallLeadNote {
  id         String   @id @default(uuid()) @db.Uuid
  callLeadId String   @map("call_lead_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  callLead CallLead @relation(fields: [callLeadId], references: [id], onDelete: Cascade)
  author   User     @relation("CallLeadNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([callLeadId, createdAt(sort: Desc)])
  @@map("call_lead_notes")
}

// ─────────────────────────────────────────────
// ImportLog — 取込履歴
// ─────────────────────────────────────────────

model ImportLog {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  sourceType       ImportSourceType @map("source_type")
  sourceName       String?          @map("source_name")
  importedCount    Int              @default(0) @map("imported_count")
  duplicateCount   Int              @default(0) @map("duplicate_count")
  outOfScopeCount  Int              @default(0) @map("out_of_scope_count")
  importedAt       DateTime         @default(now()) @map("imported_at")
  status           ImportLogStatus  @default(PENDING)
  errorMessage     String?          @map("error_message") @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, importedAt(sort: Desc)])
  @@map("import_logs")
}

// ─────────────────────────────────────────────
// CallLeadActivity — 架電リード活動履歴（既存 Activity は非変更）
// ─────────────────────────────────────────────

model CallLeadActivity {
  id         String                 @id @default(uuid()) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  callLeadId String                 @map("call_lead_id") @db.Uuid
  userId     String?                @map("user_id") @db.Uuid
  action     CallLeadActivityAction
  entityType CallLeadEntityType     @map("entity_type")
  entityId   String                 @map("entity_id") @db.Uuid
  metadata   Json?                  @db.JsonB
  occurredAt DateTime               @default(now()) @map("occurred_at")
  createdAt  DateTime               @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  callLead CallLead @relation(fields: [callLeadId], references: [id], onDelete: Cascade)
  user     User?    @relation("CallLeadActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([callLeadId, occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("call_lead_activities")
}

// ─────────────────────────────────────────────
// KpiGoal — 月次 / 週次 KPI 目標
// ─────────────────────────────────────────────

model KpiGoal {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  userId      String?        @map("user_id") @db.Uuid // null = チーム目標
  metricType  KpiMetricType  @map("metric_type")
  periodType  GoalPeriodType @default(MONTHLY) @map("period_type")
  periodStart DateTime       @map("period_start") @db.Date
  targetValue Decimal        @map("target_value") @db.Decimal(12, 2)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation("KpiGoalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, metricType, periodType, periodStart])
  @@index([tenantId, periodStart])
  @@index([userId, periodStart])
  @@map("kpi_goals")
}

// ─────────────────────────────────────────────
// ActivityMetricDaily — 日次行動量スナップショット（同期集計キャッシュ）
// ─────────────────────────────────────────────

model ActivityMetricDaily {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  userId     String?       @map("user_id") @db.Uuid // null = チーム合計
  metricType KpiMetricType @map("metric_type")
  date       DateTime      @db.Date
  value      Decimal       @db.Decimal(12, 2)
  computedAt DateTime      @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation("ActivityMetricUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, metricType, date])
  @@index([tenantId, date])
  @@index([userId, date])
  @@map("activity_metrics_daily")
}
