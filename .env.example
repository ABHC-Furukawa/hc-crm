# Supabase PostgreSQL (Prisma)
# App runtime: Supabase connection pooler (port 6543). Newer projects use aws-1-[region].
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: pooler session mode (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Password reset redirectTo（本番は実際の URL に変更）
NEXT_PUBLIC_SITE_URL="http://localhost:3003"
# Server-only: user account creation (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only: nightly KPI cache sync (GitHub Actions / scripts/sync-activity-metrics-daily.mjs)
CRON_SECRET="generate-a-long-random-string"
# Production URL for cron script (GitHub secret APP_URL). Local dev uses NEXT_PUBLIC_SITE_URL.
APP_URL="https://your-production-domain.example"

# Phase 5: Job Operations — Google Sheets sync
# Spreadsheet ID (1 file, tabs per company): URL /d/{ID}/edit
JOB_SPREADSHEET_ID="your-spreadsheet-id"
# Optional: override tab configs as JSON array (see lib/jobs/sheets/company-sheet-config.ts)
# JOB_SHEET_TABS='[{"companyKey":"company-01","displayName":"A社","sheetName":"A社","headerRow":1,"dataStartRow":2}]'
# Service account JSON (single line). Share the spreadsheet with the SA email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Optional: tenant UUID for cron sync (defaults to default tenant)
# JOB_SYNC_TENANT_ID="a0000000-0000-4000-a000-000000000001"